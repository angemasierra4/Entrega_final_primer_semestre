

:root {
    --verde: rgba(53, 66, 34, 0.588);   
    --verde-oscuro: rgb(53, 66, 34);     
    --verde-medio: rgba(96, 123, 55, 0.588);
    --alto-encabezado: 76px;             
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    padding-top: var(--alto-encabezado); 
    overflow-x: hidden;                  
}


#Inicios, #Servicios, #Galeria, #Formulario, #Formulario2 {
    scroll-margin-top: calc(var(--alto-encabezado) + 10px);
}

img {
    max-width: 100%;
    height: auto;
}


.encabezado {
    background-color: white;
    min-height: var(--alto-encabezado);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    z-index: 1050;
}

.logo {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
}

.encabezado .nav-link {
    color: var(--verde-oscuro);
    font-weight: bold;
}

.boton,
.reserva-cita-boton {
    display: inline-block;
    background-color: var(--verde-oscuro);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    text-decoration: none;
}

.boton:hover {
    color: white;
    background-color: #1f2713;
}


@media (max-width: 767.98px) {
    .reserva-cita-boton {
        display: block;
        text-align: center;
        margin-bottom: 10px;
    }
}


.carousel-item {
    height: clamp(220px, 45vw, 600px);   
}

.carousel-item img {
    height: 100%;
    object-fit: cover;                   
}


.h1-1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin-bottom: 1rem;
}

.h2-1 {
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    margin-bottom: 1rem;
}

.descripcion-servicios {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-style: italic;
    color: var(--verde-oscuro);
}

.img-relax {
    display: block;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    border-radius: 10px;
}


.section-servicios {
    background-color: cornsilk;
    text-align: center;
}

.titulo-seccion {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--verde-oscuro);
}

.section-servicios .card {
    text-align: left;
    border-radius: 10px;
    overflow: hidden;
}

.section-servicios .card-text {
    font-size: 0.95rem;
    font-style: normal;
    color: #333;
}


.section-galery {
    text-align: center;
}

.section-galery h4 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--verde-oscuro);
}

.img-galeria {
    width: 100%;
    aspect-ratio: 4 / 3;     
    object-fit: cover;
    border-radius: 10px;
}


section p {
    font-size: 1rem;
    font-style: italic;
    color: var(--verde-oscuro);
}


.formulario-titulo {
    text-align: center;
    background-color: var(--verde);
}

.formulario-titulo h1 {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
}

.formulario-titulo p {
    color: #222;
    font-size: 1.1rem;
}

.formato-formulario {
    background-color: var(--verde);
}

.formato-formulario fieldset {
    max-width: 960px;
}

.formato-formulario label {
    font-size: 1.1rem;
}

.boton-reserva {
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    border: none;
    border-radius: 20px;
    padding: 10px 28px;
    background-color: green;
    color: white;
    max-width: 100%;
}

.boton-reserva:hover {
    background-color: darkgreen;
}


.position-logo-fixed {
    position: fixed;
    bottom: 10px;
    right: 10px;
    width: 64px;
    height: 64px;
    background-color: rgb(239, 243, 193);
    border-radius: 15px;
    z-index: 1040;
}

.logo-whatsapp {
    width: 100%;
    height: 100%;
    border-radius: 15px;
}

@media (min-width: 768px) {
    .position-logo-fixed {
        width: 80px;
        height: 80px;
    }
}

{
    background-color: var(--verde-oscuro);
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 12px;
    margin-right: 8px;
    margin-bottom: 25px;
    cursor: pointer;
}

.nombre-completo,
.servicios,
.fecha-hora,
.personal-data {
    text-align: center;
    font-size: 15px;
    color: var(--verde-oscuro);
    margin-top: 15px;
    margin-bottom: 5px;
}

.input-nombre,
.select-service,
.select-time {
    background-color: var(--verde-medio);
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px;
    width: 100%;
    max-width: 300px;
    margin-bottom: 15px;
}

.personal-data-check {
    width: 18px;
    height: 18px;
    margin-bottom: 15px;
}

.confirm-booking {
    background-color: var(--verde-medio);
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px 25px;
    font-size: 15px;
    cursor: pointer;
    margin-bottom: 20px;
}

.confirm-booking:hover {
    background-color: var(--verde);
}
