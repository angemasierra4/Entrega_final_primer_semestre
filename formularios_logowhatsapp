        <form class="formato-formulario pb-5" action="" method="post">
            <fieldset class="container">
                <div class="row g-3 justify-content-center">
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="Id">Identificación:</label>
                        <input class="form-control" id="Id" name="identificacion" type="text" inputmode="numeric" required>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="Name">Nombres:</label>
                        <input class="form-control" id="Name" name="nombres" type="text" autocomplete="given-name" required>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="User">Apellidos:</label>
                        <input class="form-control" id="User" name="apellidos" type="text" autocomplete="family-name" required>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="Phone">Teléfono:</label>
                        <input class="form-control" id="Phone" name="telefono" type="tel" autocomplete="tel" required>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="Email">Correo:</label>
                        <input class="form-control" id="Email" name="correo" type="email" autocomplete="email" required>
                    </div>
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label" for="City">Ciudad:</label>
                        <input class="form-control" id="City" name="ciudad" type="text" autocomplete="address-level2" required>
                    </div>
                    <div class="col-12 text-center mt-4">
                        <button class="boton-reserva" type="submit">Realizar Reserva</button>
                    </div>
                </div>
            </fieldset>
